{
  "screen": "flip",
  "w": 480,
  "h": 480,
  "screen_bg": "#000000",
  "font": "fonts/DejaVuSans.ttf",
  "font_charset": " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~",
  "objects": [
    {
      "type": "container",
      "parent": -1,
      "name": "clock_page",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "bg_color": "#000000",
      "bind": "clock_page_visible",
      "bind_target": "visible",
      "hidden": false,
      "events": [
        {
          "event": "long",
          "action": "call",
          "target_name": "open_settings"
        }
      ]
    },
    {
      "type": "image",
      "parent": 0,
      "name": "face",
      "x": 16,
      "y": 128,
      "w": 448,
      "h": 224,
      "image": "face.png",
      "codec": "lossless",
      "bind": "face"
    },
    {
      "type": "label",
      "parent": 0,
      "name": "status",
      "x": 20,
      "y": 390,
      "w": 440,
      "h": 28,
      "font_size": 16,
      "fg_color": "#888888",
      "text": "Syncing time...",
      "text_align": "center",
      "bind": "status",
      "bind_target": "text"
    },
    {
      "type": "container",
      "parent": -1,
      "name": "settings_page",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "bg_color": "#000000",
      "bind": "settings_page_visible",
      "bind_target": "visible",
      "hidden": true
    },
    {
      "type": "button",
      "parent": 3,
      "name": "back",
      "x": 16,
      "y": 16,
      "w": 86,
      "h": 48,
      "text": "Back",
      "font_size": 20,
      "fg_color": "#eeeeee",
      "bg_color": "#242424",
      "radius": 10,
      "callback": "back"
    },
    {
      "type": "label",
      "parent": 3,
      "name": "heading",
      "x": 116,
      "y": 20,
      "w": 240,
      "h": 44,
      "text": "Settings",
      "font_size": 28,
      "fg_color": "#eeeeee",
      "bind": "heading",
      "bind_target": "text"
    },
    {
      "type": "container",
      "parent": 3,
      "name": "menu_page",
      "x": 0,
      "y": 84,
      "w": 480,
      "h": 396,
      "bind": "menu_visible",
      "bind_target": "visible"
    },
    {
      "type": "button",
      "parent": 6,
      "name": "wifi_option",
      "x": 20,
      "y": 20,
      "w": 440,
      "h": 76,
      "text": "Wi-Fi     >",
      "font_size": 20,
      "fg_color": "#eeeeee",
      "bg_color": "#242424",
      "radius": 10,
      "callback": "open_wifi"
    },
    {
      "type": "container",
      "parent": 3,
      "name": "networks_page",
      "x": 0,
      "y": 84,
      "w": 480,
      "h": 396,
      "bind": "networks_visible",
      "bind_target": "visible",
      "hidden": true
    },
    {
      "type": "button",
      "parent": 8,
      "name": "refresh",
      "x": 354,
      "y": 0,
      "w": 110,
      "h": 44,
      "text": "Refresh",
      "font_size": 20,
      "fg_color": "#eeeeee",
      "bg_color": "#242424",
      "radius": 10,
      "callback": "refresh"
    },
    {
      "type": "label",
      "parent": 8,
      "name": "network_status",
      "x": 20,
      "y": 4,
      "w": 324,
      "h": 56,
      "text": "Scanning...",
      "font_size": 16,
      "fg_color": "#eeeeee",
      "bind": "network_status",
      "bind_target": "text"
    },
    {
      "type": "list",
      "parent": 8,
      "name": "networks",
      "x": 16,
      "y": 72,
      "w": 448,
      "h": 308,
      "item_height": 64,
      "font_size": 18,
      "bg_color": "#181818",
      "fg_color": "#eeeeee",
      "radius": 10,
      "row_template": "network_row",
      "item_count": 0
    },
    {
      "type": "container",
      "parent": 3,
      "name": "password_page",
      "x": 0,
      "y": 84,
      "w": 480,
      "h": 396,
      "bind": "password_visible",
      "bind_target": "visible",
      "hidden": true
    },
    {
      "type": "label",
      "parent": 12,
      "name": "selected_ssid",
      "x": 20,
      "y": 0,
      "w": 440,
      "h": 36,
      "text": "Network",
      "font_size": 22,
      "fg_color": "#eeeeee",
      "bind": "selected_ssid",
      "bind_target": "text"
    },
    {
      "type": "label",
      "parent": 12,
      "name": "password_mask",
      "x": 20,
      "y": 42,
      "w": 440,
      "h": 38,
      "text": "Enter password",
      "font_size": 20,
      "fg_color": "#eeeeee",
      "bind": "password_mask",
      "bind_target": "text"
    },
    {
      "type": "label",
      "parent": 12,
      "name": "password_hint",
      "x": 20,
      "y": 84,
      "w": 440,
      "h": 30,
      "text": "8-63 characters, or 64 hex digits",
      "font_size": 14,
      "fg_color": "#eeeeee",
      "bind": "password_hint",
      "bind_target": "text"
    },
    {
      "type": "keyboard",
      "parent": 12,
      "name": "password_keys",
      "x": 0,
      "y": 120,
      "w": 480,
      "h": 276,
      "font_size": 16,
      "bg_color": "#080808",
      "fg_color": "#ffffff",
      "key_color": "#292929",
      "function_color": "#444444",
      "ok_color": "#32604b",
      "key_radius": 6
    },
    {
      "type": "container",
      "parent": -1,
      "x": 0,
      "y": 0,
      "w": 448,
      "h": 64,
      "template": "network_row",
      "callback": "choose_network",
      "bg_color": "#181818"
    },
    {
      "type": "label",
      "parent": 17,
      "name": "network_row_text",
      "x": 14,
      "y": 6,
      "w": 420,
      "h": 54,
      "text": "Network",
      "font_size": 18,
      "fg_color": "#eeeeee",
      "bind": "network_row_text"
    },
    {
      "type": "button",
      "parent": 6,
      "name": "brightness_option",
      "x": 20,
      "y": 112,
      "w": 440,
      "h": 76,
      "text": "Brightness     >",
      "font_size": 20,
      "fg_color": "#eeeeee",
      "bg_color": "#242424",
      "radius": 10,
      "callback": "open_brightness"
    },
    {
      "type": "container",
      "parent": 3,
      "name": "brightness_page",
      "x": 0,
      "y": 84,
      "w": 480,
      "h": 396,
      "bind": "brightness_visible",
      "bind_target": "visible",
      "hidden": true
    },
    {
      "type": "label",
      "parent": 20,
      "name": "brightness_value",
      "x": 32,
      "y": 40,
      "w": 416,
      "h": 64,
      "text": "40%",
      "font_size": 44,
      "fg_color": "#eeeeee",
      "text_align": "center",
      "bind": "brightness_value",
      "bind_target": "text"
    },
    {
      "type": "slider",
      "parent": 20,
      "name": "brightness_slider",
      "x": 32,
      "y": 140,
      "w": 416,
      "h": 48,
      "min": 5,
      "max": 100,
      "value": 40,
      "track_size": 12,
      "radius": 20,
      "bg_color": "#333333",
      "fg_color": "#dddddd",
      "knob_color": "#ffffff",
      "bind": "brightness_slider",
      "events": [
        {
          "event": "value",
          "action": "call",
          "target_name": "brightness_change"
        },
        {
          "event": "release",
          "action": "call",
          "target_name": "brightness_save"
        }
      ]
    },
    {
      "type": "label",
      "parent": 20,
      "name": "brightness_hint",
      "x": 32,
      "y": 224,
      "w": 416,
      "h": 60,
      "text": "Drag to adjust. Saved automatically.",
      "font_size": 18,
      "fg_color": "#aaaaaa",
      "text_align": "center",
      "bind": "brightness_hint",
      "bind_target": "text"
    }
  ]
}
